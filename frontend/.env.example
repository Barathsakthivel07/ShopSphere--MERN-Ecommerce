
# ShopSphere Frontend Environment Configuration
# React + Vite

# Express backend base URL
# Local development:
VITE_API_URL=http://localhost:5000

# Production deployment:
# Configure VITE_API_URL in Vercel using your Render backend URL.
# Example: https://your-backend.onrender.com

# IMPORTANT:
# Do not store MongoDB credentials, JWT secrets,
# passwords or private API keys in VITE_ variables.
